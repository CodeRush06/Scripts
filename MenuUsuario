# <--- VARIABLES --->

opt=1

# <--- FUNCIONES --->

function menu() {
    echo "OPCION 0: SALIR DE MENU GESTION DE USUARIOS"
    echo "OPCION 1: CREAR USUARIO"
    echo "OPCION 2: CAMBIAR ATRIBUTO DE USUARIO"
    echo "OPCION 3: ELIMINAR USUARIO"
    echo "OPCION 4: BLOQUEAR USUARIO"
    echo "OPCION 5: DESBLOQUEAR USUARIO"
    echo "OPCION 6: CAMBIAR CONTRASEÑA"
    echo "OPCION 7: LISTAR A TODOS LOS USUARIOS"
}

function crearUsuario() {
    echo "OPCION CREAR USUARIO HA SIDO CONFIRMADA..."
    sleep 2s
    read -p "Ingrese nombre de usuario: " nombre

    # "^${nombre}$" exige que sea exactamente ese nombre, ni una letra mas ni una menos.

    #Verifica que el de usuario exista.
    while cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ya existe un usuario con ese nombre. Ingrese otro nombre";
    read -p "Ingrese nombre de usuario: " nombre
    done

    #Verifica que el nombre de usuario no se haya repetido.


    read -p "Ingrese grupo del usuario: " grupo

    #Verifica que grupo exista.
    while ! cut -d: -f1 /etc/group | grep -q "^${grupo}$"; do
    echo "No existe ese grupo, ingrese uno de estos.";
    cut -d: -f1 /etc/group
    read -p "Ingrese grupo del usuario: " grupo
    done

    read -p "Ingrese home de usuario: " home
    while [ -d "/home/$home" ]; do
        echo "La carpeta /home/$home ya existe. Eliga otro."
        read -p "Ingrese nombre para la carpeta HOME: " home
    done

     #Verifica que el shell exista.
    read -p "Ingrese shell de usuario: " shell
    while ! grep -q "^${shell}$" /etc/shells; do
    echo "No existe ese shell, ingrese uno de estos.";
    grep -v "^#" /etc/shells
    read -p "Ingrese shell de usuario: " shell
    done


    sudo useradd -m -g "$grupo" -d "/home/$home" -s "$shell" "$nombre"
    # Asignar CONTRASEÑA
    if [ $? -eq 0 ]; then
        echo "Ingrese la contraseña para el nuevo usuario: "
        sudo passwd "$nombre"
        echo "¡Usuario registrado en el sistema con éxito!"
    else
        echo "Error al crear el usuario."
    fi
}

function cambiarUsuario() {
    read -p "Ingrese el nombre del usuario a modificar: " nombre
    #Verificar que ese usuario existe
     while ! cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ese usuario no existe";
    read -p "Ingrese el nombre del usuario a modificar: " nombre
    done

    echo "USUARIO SELECCIONADO: $nombre"
    echo "1) Cambiar directorio personal"
    echo "2) Cambiar shell"
    echo "3) Cambiar nombre de usuario"
    read -p "Seleccione una opción: " opc

    case $opc in
        1)
            read -p "Ingrese el nuevo directorio: " nuevo_dir
            sudo usermod -d "$nuevo_dir" -m "$nombre"
            echo "Directorio modificado con éxito."
            ;;
        2)
            read -p "Ingrese la nueva shell (ej. /bin/bash): " nueva_shell

            while ! grep -q "^${nueva_shell}$" /etc/shells; do
            echo "No existe ese shell, ingrese uno de estos.";
            grep -v "^#" /etc/shells
            read -p "Ingrese la nueva shell (ej. /bin/bash): " nueva_shell
            done

            sudo usermod -s "$nueva_shell" "$nombre"
            echo "Shell modificada con éxito."
            ;;
        3)
            read -p "Ingrese el nuevo nombre de usuario: " nuevo_nom

         while cut -d: -f1 /etc/passwd | grep -q "^${nuevo_nom}$"; do
        echo "Ese nombre ya esta en uso";
         read -p "Ingrese el nuevo nombre de usuario: " nuevo_nom
        done

            sudo usermod -l "$nuevo_nom" "$nombre"
            echo "Nombre de usuario modificado con éxito."
            ;;
        *)
            echo "Opción no válida."
            ;;
    esac
}

function eliminarUsuario() {
    read -p "Ingrese el nombre de usuario a eliminar: " nombre
      #Verifica que el de usuario exista.
    while ! cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ya existe un usuario con ese nombre. Ingrese otro nombre";
    read -p "Ingrese nombre de usuario: " nombre
    done

    read -p "¿Desea eliminar también su directorio personal? (s/n): " eliminar_dir

    if [ "$eliminar_dir" = "s" ]; then
        sudo userdel -r "$nombre"
    else
        sudo userdel "$nombre"
    fi
    echo "Usuario eliminado del sistema con éxito."
}

function desbloquear_user() {
    read -p "Ingrese el nombre de usuario a desbloquear: " nombre
      #Verifica que el de usuario exista.
    while ! cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ya existe un usuario con ese nombre. Ingrese otro nombre";
    read -p "Ingrese nombre de usuario: " nombre
    done

    sudo passwd -u "$nombre"
    echo "Usuario desbloqueado con éxito."
}

function bloquear_user() {
    read -p "Ingrese el nombre de usuario a bloquear: " nombre
      #Verifica que el de usuario exista.
    while ! cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ya existe un usuario con ese nombre. Ingrese otro nombre";
    read -p "Ingrese nombre de usuario: " nombre
    done

    sudo passwd -l "$nombre"
    echo "Usuario bloqueado con éxito."
}

function listar_user() {
    echo "Listando usuarios del sistema ..."
    cut -d: -f1 /etc/passwd
}

function cambiar_password() {
    read -p "Ingrese el nombre de usuario para cambiar contraseña: " nombre
      #Verifica que el de usuario exista.
    while ! cut -d: -f1 /etc/passwd | grep -q "^${nombre}$"; do
    echo "Ya existe un usuario con ese nombre. Ingrese otro nombre";
    read -p "Ingrese nombre de usuario: " nombre
    done

    read -p "Ingrese la contraseña: " pass
    echo "$nombre:$pass" | chpasswd
}

# <--- PRINCIPAL --->

while [ $opt -ne 0 ];
do
    menu
    read -p "Selecciona una Opción" opt
    case $opt in
        0) echo "saliendo de menu GESTION DE USUARIOS..."
           exit
           ;;
        1) crearUsuario
           ;;
        2) cambiarUsuario
           ;;
        3) eliminarUsuario
           ;;
        4) bloquear_user
           ;;
        5) desbloquear_user
           ;;
        6) cambiar_password
           ;;
        7) listar_user
           ;;
        *) echo "opcion invalida, intente denuevo."
           ;;
    esac
done
